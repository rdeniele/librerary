    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search",
      "description": "Inset native search with visible focus.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search\" placeholder=\"Search apps and documents\"/><kbd>Ctrl K</kbd></label>",
      "css": ".ds-search{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;display:flex;align-items:center;gap:9px;width:324px;max-width:100%;min-height:35px;padding:7px 10px;border:1px solid var(--line,#e5e5ea);border-radius:9px;background:var(--canvas,#f5f5f7);color:var(--muted,#63636b)}.ds-search svg{flex-shrink:0}.ds-search input{font:400 12px -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;width:100%;min-width:0;border:0;outline:none;background:none;color:var(--text,#1d1d1f);caret-color:var(--accent,#0067d8)}.ds-search input::placeholder{color:var(--muted,#63636b);opacity:1}.ds-search:focus-within{outline:3px solid var(--accent,#0067d8);outline-offset:2px}.ds-search kbd{font:500 10px -apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;padding:2px 5px;border-radius:4px;border:1px solid var(--line,#e5e5ea);background:var(--surface,#fff);white-space:nowrap}"
