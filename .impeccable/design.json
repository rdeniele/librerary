      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI Variable\",\"Segoe UI\",sans-serif;font-size:13px;font-weight:550;background:#0067d8;color:#fff;border:1px solid #0067d8;border-radius:11px;padding:9px 15px;min-height:36px;cursor:pointer;transition:background 120ms ease-out,transform 100ms ease-out}.ds-primary:hover{background:#005bbd}.ds-primary:focus-visible{outline:3px solid var(--accent,#0067d8);outline-offset:3px}.ds-primary:active{transform:scale(.985)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}.ds-primary{font-weight:550;min-height:36px;transition:background-color 120ms ease-out,border-color 120ms ease-out,box-shadow 120ms ease-out,transform 100ms ease-out}.ds-primary:active:not(:disabled){transform:scale(.985)}.ds-primary:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active:not(:disabled){transform:none}}"
