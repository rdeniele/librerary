  "narrative": {
    "northStar": "A calm, native workspace",
    "overview": "The user explicitly requested an Apple-inspired redesign on 2026-10-17. This supersedes the former green tool-shelf appearance while preserving every existing workflow. The original glass document-stack logo is the expressive brand element; the workspace stays quiet, legible, and task-focused.\n\nGround truth: [active stylesheet](apps/launcher/src/apple.css), [components](apps/launcher/src/main.tsx), and [brand assets](assets/brand/README.md). Browser previews of all five screens, both themes, and narrow layouts were inspected. Native Windows remains the first delivery platform; this is a Tauri interface, not AppKit or SwiftUI.",
    "keyCharacteristics": [
      "Native system typography",
      "Blue actions on neutral surfaces",
      "Functional translucent navigation",
      "Solid reading and editing surfaces",
      "Responsive rows and controls"
    ],
    "rules": [
      {
        "name": "The Quiet Color Rule",
        "body": "Reserve saturation for actions, focus, and the original brand icon; avoid additional decorative accent palettes.",
        "section": "colors"
      },
      {
        "name": "The Native Type Rule",
        "body": "Match the host's system typography rather than downloading an Apple font for Windows.",
        "section": "typography"
      },
      {
        "name": "The Functional Glass Rule",
        "body": "Glass belongs to navigation and controls; text content stays on a readable solid surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve user data and every existing action while extending the visual system.",
      "Do keep glass, gradients and highlights restrained; let the logo carry the richer material.",
      "Do keep focus, loading, empty, disabled, success and error states readable in both themes."
    ],
    "donts": [
      "Don't fake macOS traffic-light window controls inside the Windows application.",
      "Don't add Apple logos, proprietary SF Symbols, font files or competitor artwork.",
      "Don't imply DOCX or other planned modules work because they appear in the catalog."
    ]
  }
