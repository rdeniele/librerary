{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Librerary",
  "version": "0.1.0",
  "identifier": "org.librerary.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [{ "title": "Librerary", "width": 1080, "height": 740, "minWidth": 640, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": { "active": false }
}
